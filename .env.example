# Optional runtime settings
DRIFT_DB_PATH=data/northstar_demo.sqlite
SQL_ROW_LIMIT=1000
TABLEAU_DASHBOARD_URL=

# Optional constrained LLM planner. It selects only approved analytics intents
# and filters; the app still builds and validates the read-only SQL itself.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Backend: "sqlite" (default, bundled demo) or "databricks" (gold layer on a SQL warehouse).
# Databricks mode needs: pip install -r requirements-databricks.txt
DRIFT_BACKEND=sqlite
# From the SQL warehouse's Connection details tab. Never commit a real token.
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=drift_demo
DATABRICKS_SCHEMA=gold
